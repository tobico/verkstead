/// What a Plugin's wasm component is written against (ADR-0030).
///
/// The package's major version is the manifest's `interface:` — a component
/// built against a newer one is a plugin for a newer Verkstead, and the
/// manifest says so before anything here is read.
///
/// **WASI is not named here.** The host links WASI 0.2 and WASI HTTP beside
/// these worlds whatever a component imports of them, and what any of it can
/// reach is what the manifest's `capabilities:` granted at Install: a path
/// never granted is a directory the component has no handle on, and a host
/// never named is a request refused.
package verkstead:plugin@1.0.0;

/// What every plugin component may target, and the one a component that
/// provides nothing in code is checked against.
world plugin {}

/// One world per Category, each the base and, once the stage that gives the
/// Category its grammar lands, what a component providing it exports.
///
/// **An agent's is the three things about a harness that are code** (ADR-0030,
/// *Agent*): everything else about it — its binary, its launch line, its
/// account's paths, how it idles and asks — is data, written in the manifest's
/// `agent` provision, and the host reads it there.
world agent {
  include plugin;

  /// Who said something in a session's record.
  enum voice {
    /// The agent, in its own words.
    agent,
    /// The agent, thinking.
    reasoning,
    /// Whoever put a turn to the agent: the human, or Verkstead for them.
    put,
  }

  /// Something said, as markdown.
  record said {
    voice: voice,
    markdown: string,
  }

  /// A tool the agent called.
  record tool-call {
    /// What the tool is called.
    name: string,
    /// The name the harness gave this call, which its result names back;
    /// empty where the record gave none.
    call: string,
    /// One line about the call, or empty.
    about: string,
    /// What it was called with, whole.
    input: string,
  }

  /// What a tool answered.
  record tool-result {
    /// The call this answers, by the name the harness gave it; empty where
    /// the record gave none.
    call: string,
    failed: bool,
    text: string,
  }

  /// A line of the harness's own bookkeeping: a mode it switched to, a title
  /// it invented. Folded away under `kind`.
  record notice {
    kind: string,
    line: string,
  }

  /// A line the parser does not know, kept rather than dropped (ADR-0006):
  /// with the kind the record called it, it folds away under that name;
  /// with none, it stands in the conversation where it was found.
  record unknown {
    kind: option<string>,
    line: string,
  }

  /// One thing the record of a session holds, in the kinds the Transcript
  /// pane draws.
  variant entry {
    said(said),
    tool-call(tool-call),
    tool-result(tool-result),
    notice(notice),
    unknown(unknown),
  }

  /// One of the account's configuration files as the host found it, said
  /// from the account's directory: its contents, or none where the account
  /// has no such file.
  record found {
    path: string,
    contents: option<list<u8>>,
  }

  /// An MCP server attached to the Conversation (ADR-0021).
  record server {
    /// What the agent sees in front of its tool names.
    name: string,
    url: string,
    headers: list<tuple<string, string>>,
  }

  /// A file the Built Root is to hold, said from where the account lands.
  record file {
    path: string,
    contents: list<u8>,
  }

  /// What a session's root holds of the account's configuration.
  record configuration {
    files: list<file>,
    /// The session-only settings the launch line's `{settings}` names, as
    /// JSON, or none.
    settings: option<string>,
  }

  /// What the host does next in a login, having fed the export what the
  /// harness wrote.
  variant login-step {
    /// Nothing yet: feed it more.
    waiting,
    /// The address to show the human.
    address(string),
    /// The harness is waiting for the code the human brings back, to be
    /// typed into it.
    code,
    /// Words to say to the human, such as that the code was cut short.
    words(string),
    /// The login is over.
    done,
  }

  /// What a session's record is looked for by, and how far it was read.
  record looking {
    /// The id the session is known by, where there is one: Verkstead's own
    /// for a harness named on its line, or the one an earlier answer gave.
    session: option<string>,
    /// The Worktree it runs in, for a harness that takes no id and has to be
    /// found by it.
    worktree: option<string>,
    /// And when it was launched, in milliseconds since the epoch: a record
    /// older than that is an earlier session's.
    launched: u64,
    /// What the last answer said to carry on from; none to read from the top.
    cursor: option<string>,
  }

  /// What a session's record holds past where it was last read.
  record transcript {
    /// The id the record was found under — what a resume names. None where
    /// the record does not say.
    session: option<string>,
    /// Only what is past the cursor it was handed.
    entries: list<entry>,
    /// Where this answer read to, handed back on the next call: the export's
    /// own, which the host never reads.
    cursor: string,
  }

  /// The record of the session `looking` describes, found under the account
  /// rooted at `account` and read in the kinds above from where `looking`'s
  /// cursor says — or none where there is no record of it yet. Where the
  /// record is kept is the harness's own business, so finding it is this
  /// export's as much as reading it. `account` is always `/account`: the
  /// account's directory, granted read-only under that name on every
  /// platform, whatever its path on the host.
  ///
  /// **A harness that names itself** — one whose launch line names no
  /// `{session}` — is looked for by `worktree` and `launched` until an answer
  /// gives its id, and by that id from then on: the host writes it down as
  /// what the session is called, and a resume names it.
  export parse-transcript: func(account: string, looking: looking) -> option<transcript>;

  /// What a session's root is to hold, given the account's configuration
  /// files as found — with the account's own MCP servers already taken out
  /// by the host (ADR-0011) — and the servers the Conversation attached.
  export write-configuration: func(found: list<found>, servers: list<server>) -> configuration;

  /// The next step of a login, given what the harness has written since the
  /// last call — on either of its outputs, in whatever pieces it arrived in.
  /// Called only for a harness whose manifest declares a login, in an instance
  /// of the component started for that one harness, so what it was handed
  /// before is its own to keep.
  ///
  /// After any answer but `waiting` it is asked again with nothing new, so
  /// that one piece carrying an address and a prompt is answered as both.
  ///
  /// `words` said while the code handed over is being checked put the human
  /// back at the same address with them — a code cut short. Said otherwise,
  /// and followed by the harness exiting without a login, they are what the
  /// human reads beside the fresh address the host starts — a harness giving
  /// up — as they are beside one after a code it refused.
  export login: func(written: string) -> login-step;
}

world process {
  include plugin;
}

world forge {
  include plugin;
}

world language {
  include plugin;
}

/// What an Activity is handed, what it may ask of the host, and how it ends
/// (ADR-0030, *Activity*). The words are CONTEXT.md's.
interface activity-types {
  /// A repository the Conversation works in, as its Worktree stands.
  record checkout {
    /// The Repo's name, which is what `git-facts` asks after it by.
    repo: string,
    /// The Worktree's path on this device.
    path: string,
    /// The branch the Worktree holds, and the one it was cut from.
    branch: string,
    base: string,
    /// Whether the Conversation may commit in it: always, for the Worktree,
    /// and as the Companion was attached, for a Companion.
    writable: bool,
  }

  /// A role of the Conversation's Process, and the Pairing it runs under.
  record pairing {
    role: string,
    profile: string,
    model: string,
  }

  /// One entry of the Timeline so far: its kind and its body, the body as the
  /// text the Timeline stores, which is not JSON. A brief, a handoff or a
  /// notice is its markdown; a move is the state's word, `follow-up` say; a
  /// steer is the state's word, then a newline and the instruction where the
  /// human wrote one; and a kind whose substance is held elsewhere — a
  /// session's output, a question set, a commit — has an empty body.
  record entry {
    id: s64,
    kind: string,
    body: string,
  }

  /// A skill the Activity's block declared, `<pack>/<skill>`, and where a
  /// session reads its `SKILL.md`, so the Activity can name it in the prompt
  /// it writes.
  record skill {
    name: string,
    path: string,
  }

  /// Everything an Activity starts with. Nothing is kept for it between
  /// starts: a server restarted starts it again with these, the Timeline as
  /// it now stands, and the files in the Repo, which are the truth.
  record facts {
    worktree: checkout,
    companions: list<checkout>,
    pairings: list<pairing>,
    brief: string,
    /// The handoff document, where the Conversation has one.
    handoff: option<string>,
    timeline: list<entry>,
    /// What the Process configured this state's Activity with, by key.
    options: list<tuple<string, string>>,
    skills: list<skill>,
  }

  /// A file whose arrival or going says a session is done.
  variant landing {
    /// This path, inside the Worktree, is gone.
    gone(string),
    /// This path, inside the Worktree, has arrived.
    arrived(string),
    /// `.tasks/TODO.md`'s entry with this number is ticked and committed.
    ticked(u32),
    /// The roadmap with this name is written and committed.
    roadmap(string),
    /// The handoff document has been written, at this absolute path.
    handoff(string),
  }

  /// What `verkstead done` is checked against for a session.
  variant evidence {
    landed(landing),
    /// The Conversation's commits stand past this many, the count at launch.
    committed-since(s64),
    /// Nothing to show: the work is judged elsewhere.
    nothing,
    /// The human's newest answered round carries the Nothing-else mark.
    nothing-else,
    /// The same mark in Investigating's window, uncommitted changes allowed.
    investigated,
  }

  /// How a session ends once it is done: with the work standing, or on a pull
  /// request it opened, in every repository it committed in.
  enum ends {
    with-its-work,
    on-a-pull-request,
  }

  /// A session the Activity launched, which it waits on by this.
  type session = u64;

  /// What a wait on a session came to. Every event the Activity is handed
  /// arrives here.
  variant waited {
    /// It gave its Done signal, which was taken, and is idle.
    done,
    /// It ended without one, or was ended: with the host's sentence for how,
    /// where the ending itself was the trouble — *The session exited with …* —
    /// and none where it finished, or a stop already says why.
    gone(option<string>),
    /// It stalled, and the rescue did not bring it back.
    stalled,
    /// The human steered the Conversation elsewhere. The Activity ends
    /// `steered`.
    steered,
    /// The human answered a round with the Nothing-else mark.
    marked,
  }

  /// What one repository's branch holds, read-only.
  record branch-facts {
    branch: string,
    /// Commits on the branch past its base.
    commits: u32,
    /// Whether anything in the Worktree is not committed.
    uncommitted: bool,
  }
}

/// What the host lends an Activity: every way it reaches the server.
interface host {
  use activity-types.{evidence, ends, session, waited, branch-facts};

  /// Launch a session under `skill`, `<pack>/<skill>`, as `role`, with the
  /// prompt the Activity wrote — the host adds what every session is told —
  /// expecting `evidence` of it and ending as `ends` says. Refused, in a
  /// sentence, where it cannot be launched.
  launch: func(skill: string, role: string, prompt: string, evidence: evidence, ends: ends)
    -> result<session, string>;

  /// Wait on a session until something happens to it or the Conversation.
  /// Its Done signal is checked against the `evidence` it was launched
  /// expecting for as long as it is waited on, and refused while it is not.
  wait: func(session: session) -> waited;

  /// The git facts of the Worktree's repository or a Companion's, by the
  /// Repo's name. Refused where it is neither.
  git-facts: func(repo: string) -> result<branch-facts, string>;

  /// Put a notice on the Timeline.
  notice: func(text: string);

  /// Stop: the Conversation stays where it is, the reason goes on the
  /// Timeline, and any Set left open is closed — unless the newest session
  /// launched was building (a backlog task, the finish, a stage's planning),
  /// whose Sets stand to be answered into the next session's prompt. What
  /// `run` returns after is not read.
  stop: func(reason: string);

  // Reading the Repo (stage 10). Committed bytes only, never the working
  // tree: what a session has merely written is not there until it commits.
  // **No capability is declared for these**: the Repos read are the
  // Conversation's own, on the same footing as `git-facts`, and nothing else
  // on the device is reachable through them.

  /// Where in a Repo's history a read is made.
  variant revision {
    /// The HEAD of the named Repo's Worktree: what the Conversation has
    /// committed there.
    head,
    /// A branch or a commit, resolved in the Repo itself, so a branch no
    /// Worktree holds — a roadmap chain's top, say — reads as well as one
    /// that does.
    named(string),
  }

  /// The file at `path` in `repo` — the Worktree's Repo or a Companion's, by
  /// the name `git-facts` takes — as committed at `at`, from the Repo's root:
  /// its bytes, or none where nothing is there. Refused, in a sentence, for a
  /// Repo that is neither, a revision that names no commit, a path that leads
  /// out of the Repo, or a path that is a directory.
  read-file: func(repo: string, at: revision, path: string)
    -> result<option<list<u8>>, string>;

  /// The names of the entries of the directory at `path` in `repo` as
  /// committed at `at`, `""` being the Repo's root: files and directories
  /// alike, sorted as git sorts them, or none where nothing is there. Refused
  /// as `read-file` is, and for a path that is a file.
  list-directory: func(repo: string, at: revision, path: string)
    -> result<option<list<string>>, string>;

  // Placing work by platform (stage 10). Which device runs it is the host's
  // (ADR-0029): the Activity names the platform a line of the Repo wants, and
  // never a device.

  /// Where a task is to run, once the host has placed it.
  enum placed {
    /// On this device: launch its session here.
    here,
    /// Not here: the Conversation is moving to a device of that platform, or
    /// the human is being asked where it runs. Launch nothing. The Activity is
    /// started again wherever the Conversation lands, so it ends `steered`.
    elsewhere,
  }

  /// Place the backlog task numbered `task` — `label` being that number as
  /// `.tasks/TODO.md` writes it — whose line wants `platform`, the word after
  /// its `on`, before its session is launched. A word that is not `linux`,
  /// `macos` or `windows` wants no platform, and the task runs here.
  place-task: func(task: u32, label: string, platform: string) -> placed;

  // Joining a roadmap's chain (stage 10). Which stages joined, and in what
  // order, is the host's record; the rebase onto the top is the session's.

  /// One branch of the chain a stage joins.
  record link {
    /// Which stage of the roadmap the branch is, or none for the branch the
    /// chain starts at, at its foot.
    stage: option<string>,
    branch: string,
  }

  /// Hold the finish until this Conversation may join its roadmap's chain —
  /// every stage already in it settled — and answer the chain, bottom to top,
  /// for the finish's prompt. A Conversation that is no roadmap's stage joins
  /// nothing: it is answered at once, with no branches.
  join-chain: func() -> list<link>;

  // Starting Conversations (stage 10). **Behind a capability**, the one an
  // Activity's manifest writes as `- conversations: start`: an Activity that
  // can start work is one worth knowing about at Install. Every call below is
  // refused, in a sentence, for a plugin that does not declare it.

  /// A roadmap stage to start as a Conversation of its own, against this
  /// Conversation's Repo, under its Pairings and with its companions.
  record stage {
    /// The roadmap's directory under `docs/roadmaps/`: `mvp`.
    roadmap: string,
    /// The stage's number as the roadmap's line writes it: `05`.
    label: string,
    /// What the stage is called.
    title: string,
    /// Where its brief is, from the Repo's root, under the roadmap's
    /// directory. Its name is what the stage's branch is named for.
    brief-path: string,
    /// The brief, which is the new Conversation's Brief.
    brief: string,
    /// The branch it is cut from.
    base: string,
    /// The word after its line's `on`, or empty: which device it starts on
    /// is the host's (ADR-0029). A word that is no platform wants none.
    platform: string,
    /// Whether the Repo records a way to stack a stage for review, which
    /// changes what the Timeline is told and nothing else.
    stacks: bool,
  }

  /// A stage started: its Conversation, and the branch it is on.
  record started {
    conversation: s64,
    branch: string,
  }

  /// Why a stage did not start.
  variant not-started {
    /// There is no place for it: its roadmap runs as many stages as it may,
    /// or the server as many Conversations. The sentence says which. Nothing
    /// was made, and the same start may be asked again once a place frees.
    no-place(string),
    /// It could not start, for the sentence's reason: a branch already
    /// taken, no git author, a fetch git would not make. The host has said
    /// so where it says such things already.
    halted(string),
  }

  /// Start `stage`. The host checks and makes everything around it: the
  /// branch and its Worktree, the companions, the record of which roadmap
  /// and stage it is, where it runs, and the Timeline sentences.
  start-conversation: func(stage: stage) -> result<started, not-started>;

  /// What the record says of a stage, or of the Conversation that wrote a
  /// roadmap.
  enum standing {
    /// Its work finished: it reached Done once, or it was closed having
    /// wrapped up.
    settled,
    /// Somebody, or some run, is on it.
    in-flight,
    /// Closed without having wrapped up.
    abandoned,
  }

  /// Where a Conversation is.
  record stands {
    /// The state's word: `implementing`, `done`.
    state: string,
    /// Whether it has settled, as `standing` says.
    settled: bool,
  }

  /// The state of `conversation`, one of this Repo's. Refused, in a sentence,
  /// for one that is not.
  conversation-state: func(conversation: s64) -> result<stands, string>;

  /// One stage the record holds.
  record stage-standing {
    label: string,
    standing: standing,
    /// Whether it has stopped: in flight still, and waiting on Resume.
    stopped: bool,
    /// The Conversation the standing is read from.
    conversation: s64,
  }

  /// What the record holds of one roadmap of this Repo.
  record standings {
    /// The Conversation that wrote the roadmap, where the record holds one.
    planner: option<standing>,
    /// Every stage it holds a row for, in no order of the roadmap's.
    stages: list<stage-standing>,
  }

  /// What the record holds of `roadmap`, in this Repo.
  stage-standings: func(roadmap: string) -> result<standings, string>;

  /// The stages of `roadmap` that have joined its chain, bottom to top.
  stage-chain: func(roadmap: string) -> result<list<link>, string>;
}

/// An Activity's component, run once per start.
world activity {
  include plugin;
  import host;
  use activity-types.{facts};

  /// Run to the end, answering the Outcome: one of the words the block
  /// declares under `outcomes`, or `steered`, which every Activity has. An
  /// Outcome never names a state; the Process maps it to one.
  export run: func(facts: facts) -> string;
}

world skills {
  include plugin;
}
