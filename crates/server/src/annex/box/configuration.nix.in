# What the Annex's box is, written whole by its Keeper beside `flake.nix` — see
# `crates/server/src/annex/flake.rs`. Nothing here is the human's to edit.
{
  lib,
  pkgs,
  unstable,
  binary,
  version,
  ...
}:

{
  # NixOS-WSL's defaults, systemd and all.
  wsl.enable = true;

  # The Keeper's own, so the Devices row reads as the same machine rather than
  # as NixOS's `nixos`. NixOS-WSL hands it to WSL as the distro's hostname.
  networking.hostName = "@hostName@";

  # And the shell this box opens logs in as the service's own user rather than
  # as NixOS-WSL's `nixos`: a repository the human clones by hand there is then
  # owned by the user the server runs git as, so there is no shared group, no
  # ACL and no `safe.directory` anywhere — git never sees an owner it is not
  # (ADR-0024, *Open repo asks where the repository is*).
  wsl.defaultUser = "verkstead";

  users.users.verkstead = {
    # NixOS-WSL makes its default user a normal one. The module's `verkstead`
    # is a system user and stays one — nothing about it as a service moves —
    # so that flag is forced back off, and what a normal user would have been
    # given comes from the two settings below instead.
    isNormalUser = lib.mkForce false;

    # A home that exists, which is where that shell lands and where a
    # `gh auth login` run in it keeps its login. Not the service's own `HOME`,
    # which stays under the state directory, where the module puts it.
    home = "@home@";
    createHome = true;

    # Sudo, as NixOS-WSL's own default user has it: a rebuild of this box is
    # run from this shell.
    extraGroups = [ "wheel" ];
  };

  services.verkstead = {
    enable = true;

    # Ports of the Annex's own and never the Keeper's 8422 and 8423: under
    # WSL's mirrored networking the two share a loopback and interfaces.
    listen = "@listen@";
    peerListen = "@peerListen@";

    # Where the Annex's Repos are — its own parent, and the login user's home,
    # which is where the human's own clones land. The namespace the service
    # runs in holds these and the state directory and nothing else.
    paths = [
      "@repos@"
      "@home@"
    ];

    # An Annex is never advertised: its Keeper's forward is where it is
    # reached.
    advertising = false;

    # The release binary of the Keeper's version, wrapped as the release
    # package is — git on its `PATH`.
    package =
      pkgs.runCommand "verkstead-${version}"
        {
          nativeBuildInputs = [ pkgs.makeWrapper ];
          meta.mainProgram = "verkstead";
        }
        ''
          install -D -m755 ${binary} $out/bin/verkstead
          wrapProgram $out/bin/verkstead --prefix PATH : ${lib.makeBinPath [ pkgs.git ]}
        '';
  };

  # WSL 2.9.8 and later generate a unit that runs `/bin/true`, which NixOS-WSL
  # 2605.7.2's `/bin` lacks, so it fails and with it every `nixos-rebuild
  # switch`. NixOS-WSL#1101 adds it to `/bin`; until a release carries that,
  # the unit is pointed at coreutils'. Harmless once one does.
  systemd.services.wsl-mnt-guard = {
    overrideStrategy = "asDropin";
    serviceConfig.ExecStart = [
      ""
      "${pkgs.coreutils}/bin/true"
    ];
  };

  # Where the Annex's Repos live, the service's own and readable from Explorer
  # at `\\wsl$`.
  systemd.tmpfiles.rules = [ "d @repos@ 0755 verkstead verkstead -" ];

  # Everything a session needs, because on NixOS the wizard installs nothing.
  #
  # `gh-stack` is on this list rather than installed into anybody's home. A
  # home is the one place `gh` looks for an extension and the one place a
  # session never reaches, its own being a fresh directory of its
  # Conversation's — so what reaches a session is this file, bound into the
  # place `gh` looks. See `stack_extension` in
  # `crates/server/src/sandbox.rs`. From unstable because stable's is 0.0.4
  # and `docs/agents/git-workflow.md` was measured against 0.1.1.
  environment.systemPackages = [
    pkgs.bubblewrap
    pkgs.git
    pkgs.gh
    pkgs.nix
    pkgs.sccache
    unstable.claude-code
    unstable.codex
    unstable.gh-stack
    unstable.opencode
  ];

  # So the next rebuild of this flake needs nothing said on its command line.
  nix.settings.experimental-features = [
    "nix-command"
    "flakes"
  ];

  system.stateVersion = "@stateVersion@";
}
