/target
/result
*.db
*.db-shm
*.db-wal
/web/node_modules
/web/dist
/web/dist-share
/desktop/node_modules
/desktop/dist
.direnv
/.pnpm-store

# Blender writes one of these beside a file every time it saves over it.
*.blend1
/plugins/target
/plugins/dist

# A core dump lands beside the checkout's root named after the process that
# left it, and is a gigabyte of someone else's memory: ignored, so that nothing
# sweeping the tree into a commit carries one in.
/core.*
